# ==========================================
# UPSGlam - Git Ignore Principal
# ==========================================

# Variables de entorno y secretos (¡MUY IMPORTANTE!)
.env
keys.txt
error.txt
*.env.local
*.env.development.local
*.env.test.local
*.env.production.local

# Archivos del Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini

# Archivos de Editores e IDEs (VS Code, IntelliJ, Eclipse)
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.project
.classpath
.settings/
*.iml

# ==========================================
# Capa Backend (Java / Spring Boot / Maven)
# ==========================================
backend/target/
backend/.project
backend/.classpath
backend/.settings/
backend/*.iml
backend/.idea/

# ==========================================
# Capa GPU (Python / PyCUDA / Virtualenvs)
# ==========================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/

# ==========================================
# Capa Frontend (Flutter / Dart)
# ==========================================
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.pub-cache/
frontend/.packages
frontend/build/
frontend/android/app/key.properties
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/flutter_export_environment.sh
frontend/ios/Flutter/Flutter.podspec
frontend/assets/google-services.json
frontend/android/app/google-services.json
frontend/ios/Runner/GoogleService-Info.plist
