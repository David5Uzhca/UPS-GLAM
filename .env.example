# ==========================================
# UPSGlam - Plantilla de variables de entorno
# Copiar a .env y completar con tus credenciales de Supabase
# ==========================================

# --- Base de datos (Transaction pooler, formato R2DBC) ---
# NO uses postgresql:// aquí. Spring exige r2dbc:postgresql://
# Usuario y contraseña van separados (no embebidos en la URL).
SPRING_R2DBC_URL=r2dbc:postgresql://aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslMode=require
SPRING_R2DBC_USERNAME=postgres.TU_PROJECT_REF
SPRING_R2DBC_PASSWORD=TU_DATABASE_PASSWORD

# --- Supabase (API / Storage / referencia) ---
UPSGLAM_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
UPSGLAM_SUPABASE_ANON_KEY=TU_ANON_KEY
UPSGLAM_SUPABASE_SERVICE_KEY=TU_SERVICE_ROLE_KEY
UPSGLAM_SUPABASE_JWT_SECRET=TU_LEGACY_JWT_SECRET_OPCIONAL

# --- GPU API (Docker usa red interna) ---
UPSGLAM_GPU_API_URL=http://gpu-api:8000
